# PostMCP AI Server Environment Configuration

# Required: Your secret API key from the PostMCP AI dashboard
POSTMCPAI_API_KEY=pmcp_sec_your_api_key_here

# Optional: PostMCP AI backend URL. Defaults to https://api.postmcpai.com;
# only set this when running against a self-hosted or local backend.
POSTMCPAI_API_URL=

# Optional: Set PORT to run in Remote HTTP / SSE Mode (e.g., 3000)
# Leave blank to run in Stdio Mode for local CLI / Claude Desktop / Cursor
PORT=

# Optional: Default workspace (project) every tool call acts on.
# An API key authenticates a person, not a workspace - set this when the account
# holds more than one, or a tool call's workspaceId argument each time.
POSTMCPAI_PROJECT_ID=

# OAuth for hosted ChatGPT/Codex plugins. All three are required to enable it.
# Never put actual credentials into this example or the plugin archive.
POSTMCPAI_OAUTH_ISSUER=
POSTMCPAI_OAUTH_MONGODB_URI=
POSTMCPAI_OAUTH_ENCRYPTION_KEY=
# Optional: additional trusted HTTPS client origins, separated by commas.
POSTMCPAI_OAUTH_REDIRECT_ORIGINS=
# Exact reverse-proxy hop count. Default 0 (direct connection).
POSTMCPAI_TRUST_PROXY_HOPS=0
