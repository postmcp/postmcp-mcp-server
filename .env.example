# PostMCP AI Server Environment Configuration

# Required: Your secret API key from the PostMCP AI dashboard
POSTMCPAI_API_KEY=pmcp_sec_your_api_key_here

# Optional: Custom PostMCP AI backend service URL (Defaults to http://localhost:5023)
POSTMCPAI_API_URL=http://localhost:5023

# Optional: Set PORT to run in Remote HTTP / SSE Mode (e.g., 3000)
# Leave blank to run in Stdio Mode for local CLI / Claude Desktop / Cursor
PORT=
